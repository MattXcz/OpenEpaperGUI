# Port on the host where the editor will be reachable
APP_PORT=8099

# Home Assistant base URL (no trailing slash)
HA_URL=http://homeassistant.local:8123

# Long-lived access token from Home Assistant
# Profile -> Security -> Long-lived access tokens -> Create token
HA_TOKEN=

# Log level: debug | info | warning | error
LOG_LEVEL=info

# Extra browser origins allowed to call the API, comma separated.
# Leave empty unless you serve the frontend from a different host/port —
# the app has no authentication, so every allowed origin can read your
# projects and push to your displays.
CORS_ORIGINS=

# Hostnames the editor answers to (DNS rebinding protection), comma separated.
# IP addresses, localhost, dot-less names and *.local / *.lan / *.home.arpa
# work out of the box. Add your reverse-proxy domain here, e.g.
# epaper.example.com or *.example.com. Use * to disable the check.
ALLOWED_HOSTS=

# Home Assistant service domains "Send to display" may call, comma separated.
# Defaults to open_epaper_link.
ALLOWED_SERVICE_DOMAINS=
